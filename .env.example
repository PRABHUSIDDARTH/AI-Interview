# =============================================================================
# AI Interview Simulator - Production & Docker Environment Configuration
# =============================================================================

# Application Settings
PROJECT_NAME="AI Interview Simulator"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Security (JWT secret token generation — MUST set in production!)
SECRET_KEY="your_secure_random_jwt_secret_key_here"
JWT_SECRET="your_secure_random_jwt_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# SQLite (default with persistent volume inside Docker):
DATABASE_URL="sqlite:////app/data/sql_app.db"
# PostgreSQL (uncomment to use external or containerized PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres_password@db:5432/ai_interview"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres_password"
# POSTGRES_DB="ai_interview"

# AI Provider Configuration (mock | gemini | openai)
AI_PROVIDER="mock"
AI_API_KEY="your_ai_api_key_here"
# Optional model override (must match AI_PROVIDER). Leave empty for the code defaults
# (gemini-2.5-flash / gpt-4o-mini).
AI_MODEL="gemini-3.5-flash"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:80"

# Frontend API Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Email / SMTP Configuration (Optional - for password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_EMAIL="noreply@aiinterview.app"
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL="http://localhost:3000"
